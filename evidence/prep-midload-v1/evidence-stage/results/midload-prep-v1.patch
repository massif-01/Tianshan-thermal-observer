+    starts={e['phase']:e for e in events if e['event']=='phase_start'};ends={e['phase']:e for e in events if e['event']=='phase_end'}
+    assert any(e['event']=='background_check' and 180<=e['t']<181 for e in events)
+    for ident in ['M20','M60','M180']:
