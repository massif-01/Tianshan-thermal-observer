+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('kind',['operator','collector','guard'])
+async def test_stop_cleanup_and_no_following_load(kind):
+    if kind=='guard':r,q,events,c=await scenario(health=FakeHealth(abnormal=603))
