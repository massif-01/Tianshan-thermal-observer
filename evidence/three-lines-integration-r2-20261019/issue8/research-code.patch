+def legacy_view(case,rows,source,out):
+    view=Path(out)/'legacy-input'/case
+    run=view/'remote-result/collection'/source.name
+    run.mkdir(parents=True,exist_ok=False)
+    for n in ['manifest.json','input-profile.json']:
+        shutil.copyfile(source/n,run/n)
+    jsonl(run/'observations-0001.jsonl',rows)
