+++ b/experiments/thermal_state_estimation_r2/tests/test_observer.py
@@ -0,0 +1,196 @@
+from pathlib import Path
+import copy,json,os,sys
+import numpy as np
+import pytest
+from scipy.integrate import solve_ivp
+
+ROOT=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT));sys.path.insert(0,str(ROOT/'vendor'))
+from observer import ThermalObserver
+from synthetic import synthetic_frame,inputs
+from freeze import prior_from_training
+from stream import load_lines,make_frames,visible_rows
+from consume_example import summarize
+
+
+@pytest.fixture
+def spec():return json.loads((ROOT/'observer-spec.json').read_text())
+
+
+def test_augmented_exact_step_matches_independent_ode(spec):
+    calc=ThermalObserver(spec);state=np.array([46.,42.,35.]);u=np.array([12.,9.,.2]);p=spec['dynamic']
+    def rhs(t,x):
+        d=p['d0']+p['d1']*u[2]
+        return [-p['a']*(x[0]-x[1])+p['b_g']*u[0]+p['b_c']*u[1],p['c']*(x[0]-x[1])-d*(x[1]-x[2]),0]
+    for dt in [.0001,1.,15.,90.,300.]:
+        truth=solve_ivp(rhs,[0,dt],state,rtol=1e-12,atol=1e-13).y[:,-1]
+        assert np.max(abs(truth-calc.mean_step(state,u,dt)))<1e-9
+        F,Q=calc._transition(dt,u[2])
+        assert np.linalg.eigvalsh((Q+Q.T)/2).min()>-1e-10
+
+
+def test_cold_start_uses_LS_prior_not_Tf_equilibrium_or_M(spec):
+    o=ThermalObserver(spec);s=o.step(synthetic_frame(0,51.,inputs(0),spec,fan_visible=False))
+    assert s['observer']['available'] and s['observer']['phase']=='provisional'
+    assert s['observer']['Tf_C']==51. and s['observer']['Ts_C']!=51.
+    assert s['observer']['E_C']==spec['prior']['E_mean_C'] and s['observer']['E_C']!=24
+    assert s['observer']['uncertainty']['marginal_std_C'][1]>10
+    assert s['measurement']['last_successful_pwm'] is None
+    assert s['observer']['unknown_input_assumptions'][0]['method']=='startup_half_scale'
+    m=json.loads((ROOT/'models/primary.json').read_text());p=prior_from_training(m)
+    for k in m['parameters']:
+        if k=='E_M' or k.startswith('Ts_M'):m['parameters'][k]=999
+    assert prior_from_training(m)==p
+
+
