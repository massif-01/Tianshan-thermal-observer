+def observer_replay(frames,spec,out,full_interfaces=False):
+    out=Path(out);out.mkdir(parents=True,exist_ok=True)
+    results={}
+    for method in ['AUGMENTED-KF','CONDITIONAL-HOLD']:
+        observer=ThermalObserver(spec,method);accepted=[];previous=None
+        with (out/(method+'-interface.jsonl')).open('w') as f:
+            for frame in frames:
+                s=observer.step(frame)
+                signature=(s['observer']['phase'],tuple(s['observer']['reasons']),json.dumps(s['safety'],sort_keys=True))
+                if frame['new_TJ']:accepted.append(s)
+                if full_interfaces or frame['new_TJ'] or signature!=previous:
+                    f.write(json.dumps(s,ensure_ascii=False,allow_nan=False)+'\n')
+                previous=signature
+        jsonl(out/(method+'-accepted-states.jsonl'),accepted)
+        results[method]=accepted
+    return results
+
