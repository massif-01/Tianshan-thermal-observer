{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TTO-WEB-SERIES-v1",
  "type": "object",
  "required": [
    "snapshot_seq",
    "service_epoch",
    "run_id",
    "source_epoch",
    "model_id",
    "spec_id",
    "series"
  ],
  "properties": {
    "snapshot_seq": {
      "type": "integer",
      "minimum": 0
    },
    "service_epoch": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_epoch": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "spec_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "series": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "unit",
          "sampling",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "observed",
              "estimate"
            ]
          },
          "sampling": {
            "enum": [
              "actual_samples",
              "bucket_first_last_min_max_and_gaps",
              "joint_bucket_extrema_and_gaps"
            ]
          },
          "alignment_group": {
            "const": "tj_model"
          },
          "time_basis": {
            "const": "tj_sample"
          },
          "anchor_metric_id": {
            "const": "temperature.tj"
          },
          "estimate_stage": {
            "enum": [
              "posterior",
              null
            ]
          },
          "original_points": {
            "type": "integer",
            "minimum": 0
          },
          "returned_points": {
            "type": "integer",
            "minimum": 0
          },
          "soft_budget_exceeded": {
            "type": "boolean"
          },
          "points": {
            "type": "array",
            "maxItems": 18002,
            "items": {
              "type": "object",
              "required": [
                "t",
                "value",
                "status",
                "sample_id",
                "received_at_utc",
                "source_ref"
              ],
              "properties": {
                "t": {
                  "type": "number",
                  "minimum": 0
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "valid",
                    "unknown",
                    "invalid",
                    "stale",
                    "unverified"
                  ]
                },
                "sample_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "received_at_utc": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "phase_at_sample": {
                  "enum": [
                    "tracking",
                    "degraded",
                    null
                  ]
                },
                "reason_code": {
                  "enum": [
                    null,
                    "source_disconnected",
                    "source_ended",
                    "publication_gap",
                    "model_expired",
                    "tj_invalid",
                    "phase_unavailable",
                    "nonfinite_state",
                    "alignment_mismatch"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "model.Tf_C",
                    "model.Ts_C",
                    "model.E_C"
                  ]
                }
              },
              "required": [
                "id"
              ]
            },
            "then": {
              "required": [
                "alignment_group"
              ],
              "properties": {
                "kind": {
                  "const": "estimate"
                },
                "unit": {
                  "const": "°C"
                },
                "estimate_stage": {
                  "const": "posterior"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "alignment_group"
              ]
            },
            "then": {
              "required": [
                "kind",
                "alignment_group",
                "time_basis",
                "anchor_metric_id",
                "estimate_stage",
                "original_points",
                "returned_points",
                "soft_budget_exceeded"
              ],
              "properties": {
                "id": {
                  "enum": [
                    "temperature.tj",
                    "model.Tf_C",
                    "model.Ts_C",
                    "model.E_C"
                  ]
                },
                "unit": {
                  "const": "°C"
                },
                "points": {
                  "items": {
                    "required": [
                      "phase_at_sample",
                      "reason_code"
                    ],
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "value": {
                              "type": "null"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "status": {
                              "const": "unknown"
                            },
                            "phase_at_sample": {
                              "type": "null"
                            },
                            "reason_code": {
                              "type": "string"
                            },
                            "sample_id": {
                              "type": "null"
                            },
                            "received_at_utc": {
                              "type": "null"
                            },
                            "source_ref": {
                              "type": "null"
                            }
                          }
                        },
                        "else": {
                          "properties": {
                            "status": {
                              "const": "valid"
                            },
                            "phase_at_sample": {
                              "enum": [
                                "tracking",
                                "degraded"
                              ]
                            },
                            "reason_code": {
                              "type": "null"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
