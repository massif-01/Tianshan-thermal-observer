 await page.waitForFunction(async()=>{const s=await(await fetch('/api/v1/snapshot')).json();return s.model.phase==='unavailable'&&s.metrics.filter(m=>!m.id.startsWith('host.')).every(m=>m.value===null);});
 await page.waitForTimeout(700);
 await page.screenshot({path:'output/playwright/source-disconnected-final.png',fullPage:true});
 return {web:await page.locator('#link').innerText(),model:await page.locator('#modelPhase').innerText(),sourceStatus:await page.locator('#sourceStatus').innerText()};
}
)(page);
