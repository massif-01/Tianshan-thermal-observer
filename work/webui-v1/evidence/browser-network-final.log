 const t=Date.now();await page.waitForTimeout(15000);await cdp.detach();
 return {duration_s:(Date.now()-t)/1000,decoded_body_bytes:Object.fromEntries(bytes),completed_requests:Object.fromEntries(counts),ongoing_existing_connection_bytes:unknown,scope:'one existing local installed Chrome tab; decoded response bytes, not Ethernet wire bytes; ongoing connection is pre-existing SSE'};
