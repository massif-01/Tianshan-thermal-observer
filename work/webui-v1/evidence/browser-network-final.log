 const cdp=await page.context().newCDPSession(page);await cdp.send('Network.enable');
 const urls=new Map(),bytes=new Map(),counts=new Map();let unknown=0;
 cdp.on('Network.requestWillBeSent',e=>{urls.set(e.requestId,new URL(e.request.url).pathname);});
 cdp.on('Network.dataReceived',e=>{const p=urls.get(e.requestId);if(p){bytes.set(p,(bytes.get(p)||0)+e.dataLength);}else unknown+=e.dataLength;});
