+{
+  "contract": "TTO-CPU-ACTIVITY-INTERFACE-v1.0",
+  "direction": "testing owner supplies read-only frames; model line consumes them. This component does not acquire, schedule, install or control",
+  "deployable": false,
+  "frame": {
+    "schema": "TTO-CPU-ACTIVITY-FRAME-v1",
+    "native_ref": "original run/ref, retain raw line and source export SHA in archive",
+    "synthetic": "explicit boolean",
+    "epoch": "original source epoch; no resets at request/workblock boundaries",
+    "arrival_host": "actual receiver host, e.g. N305; not automatically Thor",
+    "arrival_boot_id": "actual boot identity or null/unknown",
+    "arrival_clock_id": "one actual receiver monotonic clock identity; missing means arrival-side unavailable",
+    "arrival_mono_s": "actual receive/read-complete on receiver clock, never source file copy time",
+    "arrived_at_utc": "separately measured receiver UTC, no curve-based cross-host alignment",
+    "source_only": "true if no real contemporaneous receiver arrival; preserve file but no timely result",
+    "features": ["gpu_pct","gpu_W","cpu_soc_mss_W","cpu_mean_pct","cpu_max_pct"],
+    "all_core_values": "retain original core ids/online/usage/frequency or raw CPU counters in source_original/reference; maximum may change core each sample"
+  },
+  "per_feature": {
+    "value": "original numeric value, independent rails in W, CPU/GPU in percent; null remains missing",
+    "available_at_mono_s": "only after actual receiver arrival; same clock as frame",
+    "valid_until_mono_s": "original eligibility support bound mapped by an evidenced clock relation; never refresh an old source identity or change production TTL",
+    "valid": "original source eligibility, independent of activity or fan safety permission",
+    "update_id": "identity of this source update, not its numeric value or repeated read call count",
+    "source_order": "monotone source sequence when known; null when not available",
+    "feature_source": "actual backend/field, unknown backend explicitly unknown",
+    "source_host/source_clock_id/source_boot_id": "source identity, unknowns retained",
+    "source_sample_mono_s/source_read_start_mono_s/source_read_end_mono_s": "Thor timestamps on identified source clock, unknowns null",
+    "window_start_mono_s/window_end_mono_s/source_window_verified": "actual metric window/evidence; querying every200ms does not establish it",
+    "age_lower_bound_ms/age_at_source_receive_ms/transport_delay_ms": "separate source age, receiver support and transport; unknown transport is null, not0",
+    "update_evidence": "raw counter/window/sequence/backend evidence; equal values may be fresh, new read of same buffer is not a new independent sample",
+    "original_ref/original_seq/raw_unit/unknowns": "retain original reference, source ordering, raw units and unresolved items"
+  },
+  "thermal_origin": {
+    "source": "unchanged native approximately1s accepted/eligible origin, no high-frequency TJ creation",
+    "required": ["ref","t","current","source_valid","source_key","epoch","arrival_clock_id","thermal"],
+    "thermal": ["available","current_TJ_C","Ts_C","E_C","conditional_inputs_rails_W_PWM","model_sha256","observer_spec_sha256","state_native_ref"],
+    "rule": "same original observer state at this origin and real current TJ; no new activity correction of state, boundary or theta. PWM and its qualification/provenance belong to original observer, never generated by activity",
+    "labels": "all original qualified TJ records and source identity retained; evaluation does per-horizon lookup independently"
+  },
+  "actual_event_optional": {
+    "required": ["event_id","submit_mono_s","done_mono_s","arrival_clock_id"],
+    "done_mono_s": "actual client protocol_DONE or null; never presumed GPU end",
+    "continuous_group": "optional actual workload grouping for repeated-trigger description, not a feature or independent episode",
+    "purpose": "reference for offline activity diagnosis only. No future schedule, planned end or request state is consumed by this candidate"
+  },
+  "cadence": {
+    "actual": "all actually arrived frames, same times for BASE/MEAN/CORE",
+    "causal_1s": "at integer receiver-monotonic seconds select last already-arrived frame; emit at that second, retain original arrival and deadlines. Never use later frame or renew its support",
+    "comparison": "report own coverage and common origins/labels across cadence conditions; difference in actual effective source rate must be supported by source evidence",
+    "unverified": "source-only or unknown clock/window results cannot certify millisecond physical ordering"
+  },
+  "activity_memory_clarification": "Frozen analysis-spec history_budget_s=3 describes the low-confirmation timer. Actual implementation retains one hysteresis state bit while valid observations remain in the intermediate band; it is not a hard3s forgetting window. All variants have the same bit/timer and original feature deadlines. This clarification changes no candidate parameter or score.",
+  "registration": {
+    "run_id": "actual new run or explicitly synthetic identifier; one thermal history",
+    "candidate_sha256/analysis_spec_sha256": "bind this frozen proposal before new inspection",
+    "declared_role": "targeted frozen check / development exploration / synthetic only; not cross-device final generalization",
+    "saw_new_data_for_parameter_selection": "if true evaluator forces development_exploration; declaration is not evidence that a threshold was actually frozen",
+    "no_automatic_extra_run": true
+  },
+  "consumer": {
+    "file": "consume.py replay --input FRAMES.jsonl --output NEW.jsonl (offline, actual code)",
+    "loopback": "consume.py serve --allow-loopback-service --port0 --duration-s60; explicit opt-in, actual receiver stamps time; producer same-boot monotonic declaration needed, otherwise unknown",
+    "field": "no device address or outbound request implementation. Future testing owner may call Processor directly in its authorised diagnostic path; this is not installation or field permission"
+  }
+}
