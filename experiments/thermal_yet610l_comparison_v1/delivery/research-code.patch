+
+
+def build_dataset(runs):
+    all_rows, sources, manifests = [], {}, []
+    periods, versions, identities = set(), set(), []
+    for run in runs:
+        result = replay(run)
+        m = result['manifest']
+        versions.add(m['record_schema'])
+        if m['record_schema'] == 2:
+            state = result['platform_state']
