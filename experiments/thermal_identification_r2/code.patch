+            A,f=matrices(m,p,artifact['parameters'][f'E_{run}'],u);eig=np.linalg.eigvals(A);rates=-eig.real
+            gain=-np.linalg.solve(A,np.eye(len(A))[:,0])[:,None]*(p[2:] if m=='G1' else p[4:])
