{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable external-reference session",
  "type": "object",
  "required": [
    "run_id",
    "site_id",
    "session_id",
    "measurement_kind",
    "instrument",
    "geometry",
    "settings",
    "time",
    "reference_record_id"
  ],
  "properties": {
    "measurement_kind": {
      "enum": [
        "fin_surface_ir",
        "backplate_surface_ir",
        "surface_contact",
        "inlet_air",
        "outlet_air",
        "ambient_user_report"
      ]
    },
    "time": {
      "type": "object"
    },
    "reference_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_input": {
      "const": false
    },
    "control_input": {
      "const": false
    }
  },
  "description": "Instrument/settings nulls are allowed; changing position or settings requires a new session."
}
