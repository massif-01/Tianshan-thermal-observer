+                held = None
+            flags = observed_flags(node, raw)
+            si = bisect.bisect_right(sample_times, t + 1e-9) - 1
+            sample = evidence['samples'][si] if si >= 0 else None
+            source_change = last_source is not None and last_source != node['source_epoch']
