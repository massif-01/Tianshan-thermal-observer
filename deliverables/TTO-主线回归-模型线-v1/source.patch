diff --git a/experiments/thermal_mainline_calibration_v1/tool/numeric_policy.py b/experiments/thermal_mainline_calibration_v1/tool/numeric_policy.py
new file mode 100644
--- /dev/null
+++ b/experiments/thermal_mainline_calibration_v1/tool/numeric_policy.py
@@ -0,0 +1,77 @@
+"""Process-local numeric startup contract; no sockets or device access.
+
+Only the pinned NumPy/SciPy OpenBLAS runtime is supported. Unknown backends or
+libraries loaded before this initializer are rejected, never declared verified.
+"""
+import copy,json,os,platform,socket,sys,time
+from datetime import datetime,timezone
+from pathlib import Path
+
+ENV_KEYS=('OPENBLAS_NUM_THREADS','OPENBLAS_DEFAULT_NUM_THREADS','OMP_NUM_THREADS',
+          'MKL_NUM_THREADS','NUMEXPR_NUM_THREADS')
+_receipt=None
+
+def _utc():return datetime.now(timezone.utc).isoformat()
+
+def _save(path,receipt):
+    if path is not None:
+        path=Path(path);path.parent.mkdir(parents=True,exist_ok=True)
+        with path.open('x') as f:json.dump(receipt,f,ensure_ascii=False,indent=2,allow_nan=False);f.write('\n')
+
+def _pool_coverage(pools,libraries):
+    # The locked wheels bundle their backends in PACKAGE/.dylibs or PACKAGE.libs.
+    # A pool for just one library cannot attest the other; shared/unrecognized layouts reject.
+    coverage={}
+    for name,lib in libraries.items():
+        root=Path(lib['module']).resolve().parent
+        roots=(root,root.parent/(name+'.libs'))
+        coverage[name]=[p['filepath'] for p in pools if any(Path(p['filepath']).resolve().is_relative_to(r) for r in roots)]
+    return coverage
+
+def initialize(receipt_path=None):
+    global _receipt
+    from . import __version__
+    from threadpoolctl import threadpool_info,__version__ as threadpoolctl_version
+    started=time.monotonic()
+    if _receipt is not None and _receipt['pid']==os.getpid():
+        r=copy.deepcopy(_receipt)
+        r['checked_at_utc']=_utc();r['checked_at_mono_s']=started
+        r['loaded_pools']=threadpool_info()
+        r['pool_coverage']=_pool_coverage(r['loaded_pools'],r['libraries'])
+        r['verified']=all(r['pool_coverage'].values()) and all(p['num_threads']==1 for p in r['loaded_pools']) and all(os.environ.get(k)=='1' for k in ENV_KEYS)
+        r['error']=None if r['verified'] else 'numeric_policy_changed_after_initialization'
+        _save(receipt_path,r)
+        if not r['verified']:raise RuntimeError(r['error'])
+        return r
+    r=dict(schema='TTO-NUMERIC-THREAD-POLICY-v1',candidate_version=__version__,pid=os.getpid(),host=socket.gethostname(),
+           executable=sys.executable,python=sys.version,platform=platform.platform(),started_at_utc=_utc(),started_at_mono_s=started,
+           inherited_environment={k:os.environ.get(k) for k in ENV_KEYS},policy={k:'1' for k in ENV_KEYS},
+           policy_scope='this candidate process numeric libraries only; not Python threads or other applications',
+           modules_already_loaded=[n for n in ('numpy','scipy') if n in sys.modules],
+           preloaded_versions={n:getattr(sys.modules.get(n),'__version__',None) for n in ('numpy','scipy')},threadpoolctl_version=threadpoolctl_version,verified=False,error=None)
+    try:
+        if r['modules_already_loaded']:raise RuntimeError('numeric_libraries_loaded_before_policy')
+        for key in ENV_KEYS:os.environ[key]='1'
+        r['applied_at_mono_s']=time.monotonic()
+        import numpy as np
+        import scipy
+        import scipy.linalg as la
+        # Force both pinned backends to load, without loading a thermal model.
+        np.dot(np.eye(2),np.eye(2));la.expm(np.zeros((2,2)))
+        r['libraries']=dict(numpy=dict(version=np.__version__,module=np.__file__,blas=np.__config__.CONFIG['Build Dependencies']['blas']),
+                            scipy=dict(version=scipy.__version__,module=scipy.__file__,blas=scipy.__config__.CONFIG['Build Dependencies']['blas']))
+        r['extension_modules']={n:getattr(sys.modules.get(n),'__file__',None) for n in ('numpy._core._multiarray_umath','scipy.linalg._fblas','scipy.linalg._flapack')}
+        r['loaded_pools']=threadpool_info()
+        r['final_environment']={k:os.environ.get(k) for k in ENV_KEYS}
+        supported=all('openblas' in x['blas']['name'].lower() for x in r['libraries'].values())
+        r['pool_coverage']=_pool_coverage(r['loaded_pools'],r['libraries'])
+        if not supported or not all(r['pool_coverage'].values()):raise RuntimeError('numeric_backend_not_verifiable_by_candidate')
+        if any(p['num_threads']!=1 for p in r['loaded_pools']):raise RuntimeError('numeric_thread_pool_is_not_single_threaded')
+        r['verified']=True
+    except Exception as exc:
+        r['error']=str(exc);r['error_class']=type(exc).__name__;r['loaded_pools']=threadpool_info()
+    r['checked_at_utc']=_utc();r['checked_at_mono_s']=time.monotonic()
+    _save(receipt_path,r)
+    if not r['verified']:raise RuntimeError('numeric_policy_failed:'+r['error'])
+    _receipt=copy.deepcopy(r)
+    return r
diff --git a/experiments/thermal_mainline_calibration_v1/tool/offline_runtime.py b/experiments/thermal_mainline_calibration_v1/tool/offline_runtime.py
new file mode 100644
--- /dev/null
+++ b/experiments/thermal_mainline_calibration_v1/tool/offline_runtime.py
@@ -0,0 +1,49 @@
+"""Research-process policy, distinct from the unchanged field OpenBLAS attestation."""
+import os
+import platform
+import resource
+import threading
+import time
+from .util import write
+
+
+def initialize(out, profile):
+    for key in ['OPENBLAS_NUM_THREADS','OPENBLAS_DEFAULT_NUM_THREADS','OMP_NUM_THREADS',
+                'MKL_NUM_THREADS','NUMEXPR_NUM_THREADS','VECLIB_MAXIMUM_THREADS']:
+        os.environ[key] = '1'
+    import numpy as np
+    import scipy
+    import scipy.linalg
+    from threadpoolctl import threadpool_info
+    np.dot(np.eye(2), np.eye(2));scipy.linalg.expm(np.zeros((2,2)))
+    names = [np.__config__.CONFIG['Build Dependencies']['blas']['name'],
+             scipy.__config__.CONFIG['Build Dependencies']['blas']['name']]
+    pools = threadpool_info()
+    if profile == 'offline_macos_accelerate_v1':
+        if platform.system() != 'Darwin' or not all('accelerate' in n.lower() for n in names):
+            raise ValueError('registered offline Accelerate runtime does not match actual libraries')
+        verified = False  # Never relabel this as field OpenBLAS pool attestation.
+    elif profile == 'offline_openblas_v1':
+        if not pools or not all('openblas' in n.lower() for n in names) or any(p['num_threads'] != 1 for p in pools):
+            raise ValueError('registered OpenBLAS single-thread runtime not verified')
+        verified = True
+    else:
+        raise ValueError('unknown registered research runtime')
+    write(out/'numeric-policy.json', dict(profile=profile, numpy=np.__version__, scipy=scipy.__version__,
+           pid=os.getpid(), backend_names=names, environment={k:os.environ[k] for k in os.environ if k.endswith('NUM_THREADS') or k=='VECLIB_MAXIMUM_THREADS'},
+           pool_introspection=pools, numerical_pool_threads_verified=verified,
+           Accelerate_thread_request=1 if profile=='offline_macos_accelerate_v1' else None,
+           limitation='Accelerate worker count not introspectable; requested single-thread, serial C trajectory, CPU/RSS recorded' if not verified else None,
+           field_runtime_attestation=False, scope='isolated offline training only; original cpu.3/observe policy unchanged'))
+    stop = threading.Event()
+    def sample():
+        while True:
+            use = resource.getrusage(resource.RUSAGE_SELF)
+            write(out/'resource-heartbeat.tmp', dict(pid=os.getpid(), monotonic_s=time.monotonic(),
+                  peak_RSS_MiB=use.ru_maxrss/(1024**2 if platform.system()=='Darwin' else 1024),
+                  user_cpu_s=use.ru_utime, system_cpu_s=use.ru_stime))
+            os.replace(out/'resource-heartbeat.tmp', out/'resource-heartbeat.json')
+            if stop.wait(.1): break
+    thread = threading.Thread(target=sample, daemon=True)
+    thread.start()
+    return stop, thread
diff --git a/experiments/thermal_mainline_calibration_v1/tool/registry.py b/experiments/thermal_mainline_calibration_v1/tool/registry.py
new file mode 100644
--- /dev/null
+++ b/experiments/thermal_mainline_calibration_v1/tool/registry.py
@@ -0,0 +1,110 @@
+"""Immutable local model versions; selections affect only new observation sessions."""
+import json
+import os
+from pathlib import Path
+import shutil
+from datetime import datetime, timezone
+from .util import read, write, sha, safe_id, load_bundle
+
+
+def now():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def load(root):
+    root = Path(root)
+    path = root/'registry.json'
+    return read(path) if path.exists() else dict(schema='TTO-LOCAL-MODEL-REGISTRY-v1', models={},
+                selected_for_next_session=None, previous_selection=None, sessions={}, frozen_reference_model_id=None,
+                device_id=None, thermal_config_id=None,
+                selection_effect='next new session only; existing session pins never change', control_permission=False)
+
+
+def save(root, state, event):
+    root = Path(root)
+    root.mkdir(parents=True, exist_ok=True)
+    path = root/'registry.json'
+    temporary = root/'registry.json.tmp'
+    write(temporary, state)
+    os.replace(temporary, path)
+    with (root/'events.jsonl').open('a') as f:
+        f.write(json.dumps(dict(at=now(), **event), ensure_ascii=False)+'\n')
+
+
+def register(root, manifest, *, device_id=None, thermal_config_id=None):
+    root, manifest = Path(root), Path(manifest).resolve()
+    record, model, _ = load_bundle(manifest)
+    state = load(root)
+    if state['device_id'] is None:
+        if not device_id or not thermal_config_id:
+            raise ValueError('first registration requires explicit device_id and thermal_config_id')
+        state.update(device_id=device_id, thermal_config_id=thermal_config_id)
+    elif ((device_id is not None and device_id != state['device_id']) or
+          (thermal_config_id is not None and thermal_config_id != state['thermal_config_id'])):
+        raise ValueError('registry belongs to another device/configuration')
+    if record.get('device_id', state['device_id']) != state['device_id'] or record.get('thermal_config_id', state['thermal_config_id']) != state['thermal_config_id']:
+        raise ValueError('candidate belongs to another device/configuration')
+    ident, digest = record['model_id'], sha(manifest)
+    if ident in state['models']:
+        if state['models'][ident]['manifest_sha256'] != digest:
+            raise ValueError('model_id already registered with different bytes')
+        return state['models'][ident]
+    dest = root/'models'/safe_id(ident)
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copytree(manifest.parent, dest)
+    copied = dest/manifest.name
+    load_bundle(copied)
+    entry = dict(manifest=str(copied.resolve()), manifest_sha256=digest, model_sha256=record['model_sha256'],
+                 parent_model_id=record.get('parent_model_id'), numerical_convergence=model.get('converged', False),
+                 data_role=record.get('data_role', 'frozen previously examined development reference'),
+                 registered_at=now(), automatic_activation=False, control_permission=False)
+    state['models'][ident] = entry
+    if state['frozen_reference_model_id'] is None and ident == 'G2-FROZEN-RM01-v1':
+        state['frozen_reference_model_id'] = ident
+        state['selected_for_next_session'] = ident
+    save(root, state, dict(action='register', model_id=ident, activated=False))
+    return entry
+
+
+def select(root, ident, *, confirm, reason, action='activate'):
+    if not confirm or not reason:
+        raise ValueError('explicit --confirm and a recorded reason are required')
+    state = load(root)
+    entry = state['models'][ident]
+    if sha(entry['manifest']) != entry['manifest_sha256']:
+        raise ValueError('registered manifest changed')
+    manifest, model, _ = load_bundle(entry['manifest'])
+    if state['frozen_reference_model_id'] not in state['models']:
+        raise ValueError('register the original frozen reference before selecting a candidate')
+    rollback = manifest.get('rollback_model_id') or manifest.get('parent_model_id')
+    if rollback is not None and rollback not in state['models']:
+        raise ValueError('rollback model must be retained before candidate selection')
+    if not model.get('converged'):
+        raise ValueError('nonconverged numerical diagnostic cannot be selected')
+    before = state['selected_for_next_session']
+    state.update(previous_selection=before, selected_for_next_session=ident)
+    save(root, state, dict(action=action, before=before, after=ident, reason=reason,
+                           effective='next_new_observation_session', control_permission=False))
+    return dict(selected_for_next_session=ident, previous_selection=before, existing_sessions_unchanged=True,
+                frozen_reference_model_id=state['frozen_reference_model_id'], control_permission=False)
+
+
+def open_session(root, session_id):
+    safe_id(session_id)
+    state = load(root)
+    if session_id in state['sessions']:
+        return state['sessions'][session_id]  # An existing session cannot be hot-switched.
+    ident = state['selected_for_next_session']
+    if ident is None:
+        raise ValueError('no explicitly selected version')
+    entry = state['models'][ident]
+    if sha(entry['manifest']) != entry['manifest_sha256']:
+        raise ValueError('session model manifest changed')
+    load_bundle(entry['manifest'])
+    pin = dict(session_id=session_id, model_id=ident, manifest_sha256=entry['manifest_sha256'],
+               manifest=entry['manifest'], model_sha256=entry['model_sha256'], opened_at=now(), control_permission=False)
+    pin.update(device_id=state['device_id'], thermal_config_id=state['thermal_config_id'],
+               state_initialization='new observer for this device/model/session; never copy another thermal state')
+    state['sessions'][session_id] = pin
+    save(root, state, dict(action='open_session', **pin))
+    return pin
diff --git a/experiments/thermal_mainline_calibration_v1/tool/util.py b/experiments/thermal_mainline_calibration_v1/tool/util.py
new file mode 100644
--- /dev/null
+++ b/experiments/thermal_mainline_calibration_v1/tool/util.py
@@ -0,0 +1,162 @@
+"""Local immutable bundles and explicit whole-run data roles."""
+import hashlib
+import json
+from pathlib import Path
+import re
+import shutil
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def read(p):
+    return json.loads(Path(p).read_text())
+
+
+def sha(p):
+    return hashlib.sha256(Path(p).read_bytes()).hexdigest()
+
+
+def write(p, obj):
+    p = Path(p)
+    p.parent.mkdir(parents=True, exist_ok=True)
+    def cast(x):
+        if hasattr(x, 'tolist'): return x.tolist()
+        if isinstance(x, Path): return str(x)
+        raise TypeError(type(x).__name__)
+    p.write_text(json.dumps(obj, ensure_ascii=False, indent=2, default=cast, allow_nan=False)+'\n')
+
+
+def safe_id(value):
+    if not isinstance(value, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,99}', value):
+        raise ValueError('invalid local model/session identifier')
+    return value
+
+
+def legacy_identity():
+    expected = read(ROOT/'tool/legacy-identity.json')
+    for name, digest in expected.items():
+        if sha(ROOT/'tool/legacy'/name) != digest:
+            raise ValueError('accepted legacy source changed: '+name)
+    return expected
+
+
+def load_bundle(path):
+    path = Path(path).resolve()
+    manifest = read(path)
+    safe_id(manifest['model_id'])
+    for name, digest in manifest['files'].items():
+        file = (path.parent/name).resolve()
+        file.relative_to(path.parent)
+        if sha(file) != digest:
+            raise ValueError('model bundle checksum mismatch: '+name)
+    model = read(path.parent/manifest['model_file'])
+    spec = read(path.parent/manifest['observer_spec_file'])
+    if model.get('model') != 'G2' or model.get('deployable') is not False or model['dynamic'] != spec['dynamic']:
+        raise ValueError('only consistent read-only G2 bundles are accepted')
+    if sha(path.parent/manifest['model_file']) != manifest['model_sha256'] or sha(path.parent/manifest['observer_spec_file']) != manifest['observer_spec_sha256']:
+        raise ValueError('model/spec identity mismatch')
+    bounds = read(ROOT/'config/solver-spec.json')['models']['G2']['bounds']
+    for name, (lo, hi) in bounds.items():
+        value = model['dynamic'][name]
+        if type(value) not in (float, int) or not lo <= value <= hi:
+            raise ValueError('outside accepted G2 bounds: '+name)
+    return manifest, model, spec
+
+
+def validate_roles(data, train, validation, *, device_id, thermal_config_id, all_seen):
+    if data.get('schema') != 'TTO-G2-MODELING-DATA-v1':
+        raise ValueError('explicit modeling-data schema required; vendor fields are not guessed')
+    runs = {r['run']: r for r in data['runs']}
+    if len(runs) != len(data['runs']) or len({r['run_id'] for r in runs.values()}) != len(runs):
+        raise ValueError('duplicate run identity: field/modeling are one process')
+    if not train or set(train) & set(validation):
+        raise ValueError('train/validation must be nonempty train and disjoint complete runs')
+    for name in set(train+validation):
+        record = runs[name]
+        if record['device_id'] != device_id or record['thermal_config_id'] != thermal_config_id:
+            raise ValueError('device or thermal configuration mismatch')
+        if record['role'] == 'seen_development' and not all_seen:
+            raise ValueError('seen development data cannot be relabelled blind')
+    return runs
+
+
+def parent_actual_fit_runs(manifest):
+    """Actual UUID lineage, including the two retained pre-UUID example bundles."""
+    ids = manifest.get('parameter_fit_actual_run_ids')
+    if ids is not None:
+        return set(ids)
+    # Legacy examples have an exact dataset/model SHA. Resolve only that known
+    # identity; never infer a parent's UUIDs from a newly supplied alias table.
+    source = ROOT/'inputs/dataset.json'
+    known = read(source)
+    frozen = read(ROOT/'baseline/frozen-model-manifest.json')
+    if manifest.get('training_dataset_sha256') == sha(source):
+        aliases = manifest['parameter_fit_train_runs']
+    elif manifest.get('model_sha256') == frozen['model_sha256']:
+        aliases = frozen['fit_runs']
+    else:
+        raise ValueError('parent actual run lineage unknown; explicit UUID lineage required')
+    mapping = {r['run']:r['run_id'] for r in known['runs']}
+    return {mapping[name] for name in aliases}
+
+
+def load_job(path, operation, parent):
+    path = Path(path).resolve()
+    job = read(path)
+    if job['operation'] != operation:
+        raise ValueError('operation differs from registered job')
+    safe_id(job['model_id'])
+    dataset = (path.parent/job['dataset']).resolve()
+    solver = (path.parent/job['solver_spec']).resolve()
+    if sha(dataset) != job['dataset_sha256'] or sha(solver) != job['solver_spec_sha256']:
+        raise ValueError('registered dataset/solver SHA mismatch')
+    data, spec = read(dataset), read(solver)
+    runs = validate_roles(data, job['train_runs'], job['validation_runs'], device_id=job['device_id'],
+                          thermal_config_id=job['thermal_config_id'], all_seen=job['all_data_seen'])
+    manifest, model, _ = load_bundle(parent)
+    if manifest['model_id'] != job['parent_model_id']:
+        raise ValueError('parent model differs from preregistration')
+    spec = dict(spec, initializations=[dict(s, G2=dict(s['G2'])) for s in spec['initializations']])
+    if len(spec['initializations']) > 6:
+        raise ValueError('at most six registered starts')
+    if operation == 'calibrate':
+        previous = parent_actual_fit_runs(manifest)
+        if previous & {runs[n]['run_id'] for n in job['train_runs']}:
+            raise ValueError('calibration data must be additional actual runs relative to parent fit data')
+        spec['initializations'][0] = dict(id='PARENT', G2=dict(model['dynamic']))
+    frozen = dict(job, dataset=str(dataset), solver_spec=str(solver), job_file_sha256=sha(path),
+                  parent_manifest=str(Path(parent).resolve()), parent_manifest_sha256=sha(parent),
+                  actual_run_ids={n:runs[n]['run_id'] for n in set(job['train_runs']+job['validation_runs'])},
+                  legacy_sources=legacy_identity())
+    return frozen, data, spec
+
+
+def create_bundle(model, job, dest, *, parent_id, fit_report):
+    dest = Path(dest)
+    dest.mkdir(parents=True, exist_ok=False)
+    shutil.copytree(ROOT/'baseline/g2_runtime', dest/'g2_runtime', ignore=shutil.ignore_patterns('__pycache__'))
+    model = dict(model, model_id=job['model_id'], parent_model_id=parent_id, deployable=False)
+    write(dest/'g2_runtime/frozen/primary.json', model)
+    spec = read(ROOT/'baseline/g2_runtime/frozen/observer-spec.json')
+    spec.update(contract='TTO-MAINLINE-CANDIDATE-OBSERVER-v1', scope='new candidate only; not activated or control qualified',
+                model_sha256=sha(dest/'g2_runtime/frozen/primary.json'), dynamic=dict(model['dynamic']))
+    # Same broad causal prior/information budget; validation future/nuisance fit is never imported.
+    write(dest/'g2_runtime/frozen/observer-spec.json', spec)
+    manifest = dict(schema='TTO-READONLY-MODEL-MANIFEST-v1', model_id=job['model_id'], parent_model_id=parent_id,
+                    model_file='g2_runtime/frozen/primary.json', observer_spec_file='g2_runtime/frozen/observer-spec.json',
+                    observer_code_file='g2_runtime/frozen/observer.py',
+                    files={str(p.relative_to(dest)):sha(p) for p in (dest/'g2_runtime').rglob('*') if p.is_file()},
+                    model_sha256=sha(dest/'g2_runtime/frozen/primary.json'),
+                    observer_spec_sha256=sha(dest/'g2_runtime/frozen/observer-spec.json'),
+                    observer_code_sha256=sha(dest/'g2_runtime/frozen/observer.py'),
+                    parameter_fit_train_runs=job['train_runs'], validation_runs=job['validation_runs'],
+                    parameter_fit_actual_run_ids=[job['actual_run_ids'][n] for n in job['train_runs']],
+                    validation_actual_run_ids=[job['actual_run_ids'][n] for n in job['validation_runs']],
+                    training_dataset_sha256=job['dataset_sha256'], data_role=job['data_role'], all_data_seen=job['all_data_seen'],
+                    device_id=job['device_id'], thermal_config_id=job['thermal_config_id'],
+                    numerical_convergence=model['converged'], fit_report=fit_report, rollback_model_id=parent_id,
+                    source_model_deployable=False, automatic_activation=False, control_permission=False,
+                    time_contract='TTO-RECEIVE-ANCHOR-v1')
+    write(dest/'model-manifest.json', manifest)
+    load_bundle(dest/'model-manifest.json')
+    return manifest
